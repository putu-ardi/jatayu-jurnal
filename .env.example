# Copy to .env for local Docker Compose only. Replace every development secret.
APP_VERSION=0.1.0
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HEALTH_CHECK_TIMEOUT_MS=3000

POSTGRES_DB=ejls
POSTGRES_USER=ejls_app
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-another-long-url-safe-password

# Used only by npm/Prisma commands run on a host that already exposes these
# dependencies. The E-JLS Compose stack intentionally publishes neither one;
# Compose overrides both URLs with private service DNS and matching passwords.
DATABASE_URL=postgresql://ejls_app:replace-with-a-long-url-safe-password@127.0.0.1:5432/ejls?schema=public
REDIS_URL=redis://:replace-with-another-long-url-safe-password@127.0.0.1:6379/0

# Google Workspace OIDC is disabled until the deployment/change-control checklist is accepted.
# Inject GOOGLE_OIDC_CLIENT_SECRET from a runtime secret manager; never commit it here.
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_ALLOWED_HOSTED_DOMAIN=school.example
GOOGLE_OIDC_REDIRECT_URI=https://ejls.school.example/api/auth/google/callback
GOOGLE_OIDC_LINK_REDIRECT_URI=https://ejls.school.example/api/auth/google/link/callback
GOOGLE_OIDC_SCHOOL_CODE=school-main

# One-shot first-admin bootstrap (docker compose --profile bootstrap run --rm bootstrap)
# Supply these through temporary environment/secret injection, then remove them.
# Never put EJLS_BOOTSTRAP_PASSWORD or a real administrator identity in this file.
# Required: EJLS_BOOTSTRAP_CONFIRM=CREATE_FIRST_ADMIN
# Production only: EJLS_BOOTSTRAP_ALLOW_PRODUCTION=I_UNDERSTAND
# Required identity values: EJLS_BOOTSTRAP_SCHOOL_CODE, EJLS_BOOTSTRAP_SCHOOL_NAME,
# EJLS_BOOTSTRAP_ADMIN_EMAIL, EJLS_BOOTSTRAP_ADMIN_NAME, EJLS_BOOTSTRAP_PASSWORD
# Optional: EJLS_BOOTSTRAP_TIMEZONE=Asia/Jakarta
